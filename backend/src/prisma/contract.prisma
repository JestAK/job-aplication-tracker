// use prisma-next

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  profiles  Profile[]
  createdAt temporal.createdAtString()
  updatedAt temporal.updatedAtString()
}

model Profile {
  id          String        @id @default(uuid())
  user        User          @relation(fields: [userId], references: [id])
  userId      String
  profileName String
  application Application[]
  cv          Cv[]
  response    Response[]
  createdAt   temporal.createdAtString()
  updatedAt   temporal.updatedAtString()
}

model Application {
  id         String   @id @default(uuid())
  profile    Profile  @relation(fields: [profileId], references: [id])
  profileId  String
  company    String
  companyUrl String?
  position   String
  vacancyUrl String?
  note       String?
  status     String
  createdAt  temporal.createdAtString()
  updatedAt  temporal.updatedAtString()
  cv         Cv?      @relation(fields: [cvId], references: [id])
  cvId       String?
}

model Cv {
  id          String        @id @default(uuid())
  profile     Profile       @relation(fields: [profileId], references: [id])
  profileId   String
  application Application[]
  fileUrl     String
  tags        String[]
  createdAt   temporal.createdAtString()
  updatedAt   temporal.updatedAtString()
}

model Response {
  id        String   @id @default(uuid())
  profile   Profile  @relation(fields: [profileId], references: [id])
  profileId String
  title     String
  content   String
  tags      String[]
  createdAt temporal.createdAtString()
  updatedAt temporal.updatedAtString()
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  createdAt temporal.createdAtString()
  expiresAt DateTime
}
